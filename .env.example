# Insurance FNOL intake & extraction — variable NAMES only, never values.
# Copy to .env.local (dev) and .env.test (tests). Both are gitignored.

# ── Database ────────────────────────────────────────────────────────────
# Dev/prod: this project's OWN Neon project. Data here is REGULATED with
# state-level retention rules — co-locating it with another build drags that
# build into the same obligations. See "Project boundaries" in CLAUDE.md.
DATABASE_URL=
DIRECT_URL=

# ── Model provider ──────────────────────────────────────────────────────
# Its own key, so rotation or revocation never touches a sibling build.
ANTHROPIC_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────
# Latency is interactive and every extraction must be auditable back to its
# source document. Stack not chosen yet; add its variables here when it is.
